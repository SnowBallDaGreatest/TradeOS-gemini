# Application Configuration
# Your application ID from the app provider
VITE_APP_ID=your-app-id-here

# Security
# Secret key for JWT token signing/verification
JWT_SECRET=your-jwt-secret-key-here

# Database
# Connection string for your database (e.g., PostgreSQL)
DATABASE_URL=

# OAuth Configuration
# URL of your OAuth server
OAUTH_SERVER_URL=http://localhost:8080

# Owner Configuration
# OpenID of the application owner
OWNER_OPEN_ID=

# Forge API (Built-in)
# URL and API key for Forge API integration
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
